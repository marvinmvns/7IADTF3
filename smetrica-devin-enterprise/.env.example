# ─── Obrigatório ────────────────────────────────────────────────────────────
# Token de autenticação do Devin Enterprise
# v3 (Service User): prefixo cog_
# v2 (Personal API Key): prefixo apk_user_
DEVIN_API_KEY=cog_sua_chave_aqui

# ─── Opcional ───────────────────────────────────────────────────────────────
# ID da enterprise (usado apenas em logs e relatórios)
DEVIN_ENTERPRISE_ID=minha_enterprise

# IDs de organizações para filtrar (separados por vírgula)
# Se vazio, coleta dados de todas as organizações
DEVIN_ORG_IDS=org_abc123,org_def456

# Período de coleta (dias para trás a partir de hoje)
DEVIN_DAYS_BACK=30

# Diretório de saída dos dados
OUTPUT_DIR=./output

# ─── Rate Limiting ──────────────────────────────────────────────────────────
DEVIN_REQUEST_DELAY=0.5
DEVIN_MAX_RETRIES=3
DEVIN_RETRY_BACKOFF=2.0
DEVIN_PAGE_LIMIT=100

# ─── Cálculo de ROI ────────────────────────────────────────────────────────
# Custo médio da hora de um desenvolvedor (USD ou BRL)
DEV_HOUR_COST=85.0

# Horas médias que um dev levaria por tarefa que o Devin resolve
AVG_TASK_HOURS=4.0

# Custo unitário por ACU (conforme contrato)
DEVIN_ACU_COST=1.0
